{
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "start:vidly": "node vidly/index.js",
    "seed:vidly": "node vidly/seed-genres.js",
    "seed:customers": "node vidly/seed-customers.js",
    "seed:movies": "node vidly/seed-movies.js",
    "seed:rentals": "node vidly/seed-rentals.js",
    "test": "npm run test:vidly --",
    "test:watch": "npm run test:vidly -- --watchAll --verbose",
    "test:node": "node --test test/*.test.js",
    "test:all": "npm run test:node && npm run test:vidly && npm run test:integration",
    "test:vidly": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.vidly.config.js --runInBand",
    "test:vidly:watch": "npm run test:watch --",
    "test:vidly:coverage": "npm run test:vidly -- --coverage",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.js --runInBand",
    "test:integration:watch": "npm run test:integration -- --watchAll --verbose",
    "test:integration:coverage": "npm run test:integration -- --coverage"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "config": "^5.0.1",
    "debug": "^4.4.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "mongoose": "^9.12.1",
    "morgan": "^1.12.1",
    "pug": "^3.0.4",
    "winston": "^3.19.0",
    "winston-mongodb": "^7.0.1"
  },
  "devDependencies": {
    "@types/morgan": "^1.9.10",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  }
}
